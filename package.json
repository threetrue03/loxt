{
  "name": "sorinote-desktop",
  "version": "2.8.0",
  "private": true,
  "description": "LOXT 로컬 전사 데스크톱 앱",
  "author": "LOXT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/pdf-assets.mjs && vite build",
    "start": "npm run build && node scripts/start.mjs",
    "test": "npm run build && node scripts/smoke.mjs",
    "test:ui": "npm run build && node scripts/ui-design-smoke.mjs",
    "preview:design": "npm run build && node scripts/preview-design.mjs",
    "bundle:python": "node scripts/bundle-python.mjs",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-icon.ps1",
    "package": "npm run bundle:python && npm run bundle:youtube && npm run assets && node scripts/editor-notices.mjs && npm run build && electron-builder --dir --win --x64",
    "package:installer": "npm run bundle:python && npm run bundle:youtube && npm run assets && node scripts/editor-notices.mjs && npm run build && node scripts/package-installer.cjs && node scripts/release-manifest.mjs",
    "test:release": "node --test scripts/release.test.cjs scripts/automatic-transcription.test.cjs scripts/external-models.test.cjs scripts/conversion-queue.test.cjs scripts/nested-folders.test.cjs scripts/trash.test.cjs scripts/library-interactions.test.cjs scripts/workspace-libraries.test.cjs scripts/transcript-timestamps.test.cjs scripts/live.test.cjs scripts/youtube.test.cjs scripts/appearance.test.cjs scripts/improvements.test.cjs scripts/settings.test.cjs scripts/memos.test.cjs scripts/panel.test.cjs scripts/folder-export.test.cjs scripts/v2-services.test.cjs scripts/connection.test.cjs scripts/sync-pdf.test.cjs scripts/drawing.test.cjs scripts/remote-sync.test.cjs scripts/documents-2.5.test.cjs scripts/model-store.test.cjs scripts/library-2.7.test.cjs scripts/library-ranges-2.7.test.cjs scripts/pdf-cancel-2.7.test.cjs scripts/static-assets-2.7.test.cjs scripts/performance-2.7.test.mjs scripts/memo-navigation.test.mjs scripts/memo-editing.test.mjs scripts/flow-2.8.test.cjs scripts/viewport-placement.test.mjs scripts/connection-recovery-2.8.test.cjs scripts/connection-recovery-2.8.test.mjs",
    "test:worker-pool": "node --test scripts/work-worker.test.cjs",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "bundle:youtube": "node scripts/bundle-youtube.mjs",
    "test:youtube": "npm run build && node scripts/youtube-smoke.mjs",
    "test:settings": "npm run build && node scripts/settings-ui-smoke.mjs",
    "test:theme": "npm run build && node scripts/theme-smoke.mjs",
    "test:memos": "npm run build && node scripts/memo-ui-smoke.mjs",
    "test:panels": "npm run build && node scripts/panel-ui-smoke.mjs",
    "test:v2": "npm run build && node scripts/v2-ui-smoke.mjs",
    "test:models": "node --test scripts/model-store.test.cjs",
    "test:2.7": "npm run build && node scripts/audit-fixes-2.7-ui.mjs",
    "test:memo-editing": "npm run build && node scripts/memo-editing-ui.mjs"
  },
  "dependencies": {
    "@blocknote/code-block": "0.55.0",
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/math-block": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@mantine/core": "8.3.11",
    "@mantine/hooks": "8.3.11",
    "@napi-rs/canvas": "1.0.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs-precompiled": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@tiptap/pm": "3.31.4",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "ws": "^8.22.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "unzipper": "0.12.5",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "local.sorinote.desktop",
    "productName": "LOXT",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release/stage5"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "*.py",
          "*.ps1",
          "requirements*.txt",
          "!test_*.py"
        ]
      },
      {
        "from": ".runtime/python",
        "to": "python-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "build/THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": ".runtime/youtube",
        "to": "youtube",
        "filter": [
          "yt-dlp.exe",
          "version.json"
        ]
      },
      {
        "from": "build/editor-licenses",
        "to": "editor-licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": true,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LOXT",
      "runAfterFinish": false,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "artifactName": "LOXT-Setup-${version}-${arch}.${ext}"
    }
  }
}
